# demo: scripted bilingual sample + extractive minutes; no model downloads.
# qwen: real Qwen ASR + translation / minutes. Never silently falls back to demo.
PROVIDER=demo
DATA_DIR=./data
HF_HOME=./models
DEVICE=cpu
ASR_MODEL=Qwen/Qwen3-ASR-0.6B-hf
# 0.6B is a low-memory functional baseline; use 4B on AUP for quality evaluation.
LLM_MODEL=Qwen/Qwen3-0.6B
# Dedicated translation. The Qwen LLM above is used for minutes only.
TRANSLATION_BACKEND=llama_cpp
TRANSLATION_MODEL=tencent/Hy-MT2-1.8B
TRANSLATION_GGUF=./models/Hy-MT2-1.8B-GGUF/Hy-MT2-1.8B-Q4_K_M.gguf
TRANSLATION_BINARY=./tools/llama.cpp/llama-server
TRANSLATION_PORT=8081
# For AUP vLLM / another managed service, select compatible and set its URL.
TRANSLATION_BASE_URL=http://127.0.0.1:8081/v1
TRANSLATION_API_KEY=
MODEL_DTYPE=auto
LOCAL_FILES_ONLY=false
# transformers or compatible (local llama.cpp / vLLM chat-completions server)
LLM_BACKEND=transformers
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=
TORCH_THREADS=6
SUMMARY_EVERY=4
# extractive: Qwen selects source sentences; output is validated against the input.
# abstractive: free-form Qwen minutes, intended for stronger models after evaluation.
SUMMARY_STYLE=extractive
MAX_PENDING=24
HOST=127.0.0.1
PORT=8765
# AUP example: /user/<URL-encoded-username>/proxy/8765 (no trailing slash).
ROOT_PATH=
